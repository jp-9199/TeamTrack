# ==============================================================================
# TeamTrack Enterprise Production Environment Configuration
# Copy this file to .env on your production server: cp .env.production.example .env
# ==============================================================================

# 🌐 1. Public Domain & SSL Configuration
# Set your real registered domain name here. Caddy will automatically generate free Let's Encrypt SSL!
SITE_ADDRESS=teamtrack.example.com
CADDY_ENVIRONMENT=production

# 🗄️ 2. PostgreSQL Production Database
DB_USER=teamtrack_admin
DB_PASSWORD=ChangeThisToASecureRandomPassword123!
DB_NAME=teamtrack_prod
DATABASE_URL=postgresql://teamtrack_admin:ChangeThisToASecureRandomPassword123!@postgres:5432/teamtrack_prod

# ⚡ 3. Redis Pub/Sub Cache
REDIS_URL=redis://redis:6379

# 🔑 4. Security & JWT Credentials (Must be strong 32+ character secrets)
ACCESS_TOKEN_SECRET=replace-with-a-very-long-and-secure-random-access-token-secret-64chars
REFRESH_TOKEN_SECRET=replace-with-a-very-long-and-secure-random-refresh-token-secret-64chars

# 🌐 5. CORS Origins
CORS_ORIGIN=https://teamtrack.example.com

# 📦 6. File Storage
STORAGE_DRIVER=local

# 🤖 7. AI Copilot Integration (Optional Cloud Providers)
# If provided, TeamTrack AI Copilot automatically uses live Gemini / OpenAI models
GEMINI_API_KEY=
OPENAI_API_KEY=

# 💻 8. Frontend Endpoints (Bakes into Next.js client bundle)
NEXT_PUBLIC_API_URL=https://teamtrack.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://teamtrack.example.com/ws
