# ==============================================================================
# TeamTrack Environment Configuration Template (.env.example)
# Note: Use safe placeholder values. Never commit secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ==============================================================================
# REQUIRED PRODUCTION CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PORT=4000
API_URL=https://YOUR_DOMAIN/api/v1
WS_URL=wss://YOUR_DOMAIN/ws

# Database Configuration (PostgreSQL 16+)
# PostgreSQL should be private/internal where possible
DATABASE_URL=postgresql://user:placeholder_password@localhost:5432/teamtrack_db

# Authentication & JWT Configuration
# MUST be set to a cryptographically secure random string (minimum 32 characters).
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ACCESS_TOKEN_ISSUER=teamtrack-backend
ACCESS_TOKEN_AUDIENCE=teamtrack-client

# CORS Configuration (comma-separated allowed origins)
# Example: https://YOUR_DOMAIN
CORS_ORIGIN=https://YOUR_DOMAIN

# Redis Configuration (Required authority for production distributed rate limiting)
REDIS_URL=redis://localhost:6379

# ==============================================================================
# OPTIONAL / INFRASTRUCTURE SPECIFIC CONFIGURATION
# ==============================================================================

# S3-Compatible Object Storage Configuration
# Driver options: 's3' | 'mock' (production requires 's3' with valid credentials; mock is disallowed in production)
STORAGE_DRIVER=mock
S3_BUCKET=teamtrack-uploads
S3_REGION=us-east-1
# S3_ENDPOINT is optional for AWS S3; required for MinIO / Cloudflare R2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# WebRTC & Realtime Configuration
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Cookie Security Configuration (Web HttpOnly Refresh Cookie)
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Web Application Configuration (Client Side)
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api/v1
NEXT_PUBLIC_WS_URL=wss://YOUR_DOMAIN/ws
