{
  "name": "@teamtrack/desktop",
  "version": "0.1.0",
  "author": "TeamTrack Enterprise",
  "description": "TeamTrack Desktop Shell (Electron + TypeScript)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "pack:asar": "tsc && node scripts/update-asar.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package:win": "electron-builder --win -c electron-builder.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "33.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
